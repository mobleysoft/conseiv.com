{
  "name": "conseiv-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "wrangler dev --port 8796",
    "test": "npm run build && npm run package:worker -- --outdir .test-build && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run test",
    "db:local": "wrangler d1 migrations apply DB --local",
    "package:worker": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "wrangler": "4.129.0",
    "miniflare": "5.20260820.0-alpha",
    "@playwright/test": "1.63.0"
  }
}
